# Localhost Vercel Masking
VERCEL_URL=localhost:3000
NEXT_PUBLIC_VERCEL_URL=localhost:3000

# AuthJS
## Basic
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=$AUTH_URL
AUTH_SECRET=REPLACE_ME
AUTH_REDIRECT_PROXY_URL=https://REPLACE_ME
## Google
AUTH_GOOGLE_ID=REPLACE_ME
AUTH_GOOGLE_SECRET=REPLACE_ME
## Github ~ Unused Currently
AUTH_GITHUB_ID=REPLACE_ME
AUTH_GITHUB_SECRET=REPLACE_ME
## Discord ~ Unused Currently
AUTH_DISCORD_ID=REPLACE_ME
AUTH_DISCORD_SECRET=REPLACE_ME
DISCORD_GUILD_ID=REPLACE_ME
## Twitch
AUTH_TWITCH_ID=REPLACE_ME
AUTH_TWITCH_SECRET=REPLACE_ME

# PlayFab
PLAYFAB_TITLE_ID=REPLACE_ME
PLAYFAB_SECRET_KEY=REPLACE_ME

# OpenSea
OPENSEA_API_KEY=REPLACE_ME

# WalletConnect
WALLETCONNECT_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$WALLETCONNECT_PROJECT_ID

# Epic - server-only website OAuth credentials; never use NEXT_PUBLIC names
AUTH_EPIC_ID=REPLACE_ME
AUTH_EPIC_SECRET=REPLACE_ME

# postresql
DATABASE_URL=REPLACE_ME

# api
ENGINE_ACCESS_TOKEN=REPLACE_ME
ENGINE_BASE_URL=REPLACE_ME
ENGINE_FACTORY_MANAGER=REPLACE_ME
ENGINE_ACCOUNT_FACTORY=REPLACE_ME

# EvoVerses
EVOVERSES_API_KEY=REPLACE_ME

# thirdweb
THIRDWEB_ADMIN_PRIVATE_KEY=REPLACE_ME
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=REPLACE_ME
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN=localhost:3000
THIRDWEB_SECRET_KEY=REPLACE_ME

# New Nursery deployments on Avalanche C-Chain. Leave blank until verified.
NEXT_PUBLIC_BREEDER_BERTHA_ADDRESS=
NEXT_PUBLIC_HATCHER_HERMANN_ADDRESS=

# Public Evo wallet data and artwork (read-only APIs).
NEXT_PUBLIC_EVOVERSES_GRAPHQL_URL=https://api.evoverses.com/graphql
NEXT_PUBLIC_BASE_API_IMAGE_URL=https://imagedelivery.net/rnUCH_14xCvfZoyELQslRQ
NEXT_PUBLIC_API_IMAGE_SUFFIX=public

# Development UI preview only; legacy wallet sign-in disabled. A real public Thirdweb client ID enables direct external-wallet connection. Never use this preview flag in production.
# NEXT_PUBLIC_EVOVERSES_LOCAL_WALLET_PREVIEW=1

# Local-only Epic game-account bridge. Production ignores these switches.
# Website credentials use the server-only AUTH_EPIC_ID and AUTH_EPIC_SECRET values above.
# Never put ClientSecret, provider proof or player-session tokens in NEXT_PUBLIC variables.
EVOVERSES_LOCAL_EPIC_ACCOUNT_LOGIN=0
NEXT_PUBLIC_EVOVERSES_LOCAL_PLAYER_LOGIN=0
EVOVERSES_LOCAL_EPIC_RUN_ROOT=

# Local Stripe test Checkout. All switches off by default; production adapter is unavailable.
# Configure only in ignored apps/website/.env.local. Never paste keys into chat/git.
# scripts/start-stripe-sandbox.cjs verifies the approved prices and captures the CLI signing secret.
EVOVERSES_LOCAL_STORE_PAYMENTS=0
EVOVERSES_LOCAL_STORE_SERVICE_TOKEN=
EVOROS_STRIPE_ENABLED=false
EVOROS_STRIPE_MODE=test
EVOROS_STRIPE_ACCOUNT=
EVOROS_STORE_ORIGIN=http://localhost:3100
EVOROS_STRIPE_PRICES=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
