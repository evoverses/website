{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evoverses-beta",
  "account_id": "3d3ab7e213d8eaf914dbdd43d7eb38ea",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "beta.evoverses.com/*",
      "zone_id": "3adca176848846d97901677ea588989b"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "evoverses-beta"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "EVOVERSES_HOSTED_BETA": "1",
    "EVOVERSES_ACCOUNT_API_ORIGIN": "https://beta-accounts.evoverses.com",
    "EVOVERSES_EPIC_DEPLOYMENT_ID": "6452c3b6b95844609351018f0cf003ec",
    "EVOVERSES_EPIC_APPLICATION_ID": "fghi4567d1yDjn0tjuMtOqkL1USlMIC4",
    "AUTH_EPIC_ID": "xyza7891pYyJBBWl9JM5GaAOt7zWIaiK",
    "NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN": "beta.evoverses.com",
    "NEXT_PUBLIC_THIRDWEB_CLIENT_ID": "e9cc45db934afb8275fa2b1da8ce6ab6",
    "NEXT_PUBLIC_EVOVERSES_GRAPHQL_URL": "https://api.evoverses.com/graphql",
    "NEXT_PUBLIC_BASE_API_IMAGE_URL": "https://imagedelivery.net/rnUCH_14xCvfZoyELQslRQ",
    "NEXT_PUBLIC_API_IMAGE_SUFFIX": "public",
    "NEXT_PUBLIC_AUTH_URL": "https://beta.evoverses.com",
    "NEXT_PUBLIC_FUJI_EVO_ADDRESS": "0x8DEE7Bc23aB2956F99E4830D5C7Da233617B8213",
    "NEXT_PUBLIC_FUJI_EVO_NFT_ADDRESS": "0x1454b95c0e1A7059B8c99F54F8E4F6455Cbcce84",
    "NEXT_PUBLIC_FUJI_BERTHA_ADDRESS": "0xe39A19Fe7FFbE17693941D34858408a0133D69Ff",
    "NEXT_PUBLIC_FUJI_HERMANN_ADDRESS": "0x98e5f17cd25a3d4f48374E528c4ADA9DAE10b931",
    "NEXT_PUBLIC_FUJI_WRAPPER_ADDRESS": "0x327B83F409E1D5f13985c6d0584420FA648f1F56",
    "NEXT_PUBLIC_NURSERY_REGISTRY_VERSION": "2",
    "NEXT_PUBLIC_FUJI_HERMANN_HISTORY": "0x7D0a47E56E4804A606669D6b395AD430c9ADD25E,0x7B252B2B63747E1F56C6b485d6a41B8C09302Cef"
  },
  "limits": {
    "cpu_ms": 3000
  },
  "r2_buckets": [
    {
      "binding": "GAME_BUILDS",
      "bucket_name": "evoverses-beta-builds"
    }
  ],
  "keep_names": false
}
