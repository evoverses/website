{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evoverses-production",
  "account_id": "3d3ab7e213d8eaf914dbdd43d7eb38ea",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "evoverses-production"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "EVOVERSES_HOSTED_BETA": "1",
    "EVOVERSES_ACCOUNT_API_ORIGIN": "https://beta-accounts.evoverses.com",
